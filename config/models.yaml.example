# LLM Model Configuration Example
# Copy this file to models.yaml and fill in your credentials

# Example 1: Using a standard LLM service
llm:
  base_url: "https://api.your-service.com/v1"
  api_key: "your-api-key-here"
  model: "your-model-name"
  temperature: 0.1
  max_tokens: 128000

# Example 2: Using GPT-4
# llm:
#   base_url: "https://api.openai.com/v1"
#   api_key: "sk-..."
#   model: "gpt-4"
#   temperature: 0.1
#   max_tokens: 128000

# Example 3: Using Claude
# llm:
#   base_url: "https://api.anthropic.com/v1"
#   api_key: "sk-ant-..."
#   model: "claude-3-sonnet-20240229"
#   temperature: 0.1
#   max_tokens: 128000

# Example 4: Using local service
# llm:
#   base_url: "http://localhost:8000/v1"
#   api_key: "local"
#   model: "local-model"
#   temperature: 0.1
#   max_tokens: 128000
