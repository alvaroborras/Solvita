# LLM Model Configuration Example
# Copy this file to models.yaml and fill in your API keys

models:
  openai:
    api_key: "your-openai-api-key-here"
    model: "gpt-4"
    temperature: 0.1
    max_tokens: 4000
  
  anthropic:
    api_key: "your-anthropic-api-key-here"
    model: "claude-3-sonnet-20240229"
    temperature: 0.1
    max_tokens: 4000
  
  local:
    model_path: "/path/to/local/model"
    device: "cuda"
    temperature: 0.1

